import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/core/env",
}

///|
struct BrowserBundle {
  package_path : String
  name : String
  title : String
}

///|
fn smoke_bundles() -> Array[BrowserBundle] {
  [
    BrowserBundle::{
      package_path: "tests/browser/moonbit/component",
      name: "component",
      title: "MoonBit Viewer Component Test",
    },
    BrowserBundle::{
      package_path: "tests/browser/moonbit/reveal",
      name: "reveal",
      title: "MoonBit Viewer Reveal Test",
    },
    BrowserBundle::{
      package_path: "tests/browser/moonbit/read_api",
      name: "read_api",
      title: "MoonBit Viewer Read API Test",
    },
    BrowserBundle::{
      package_path: "tests/browser/moonbit/whitespace",
      name: "whitespace",
      title: "MoonBit Viewer Whitespace Test",
    },
    BrowserBundle::{
      package_path: "tests/browser/moonbit/whitespace_selection",
      name: "whitespace_selection",
      title: "MoonBit Viewer Whitespace Selection Test",
    },
    BrowserBundle::{
      package_path: "tests/browser/moonbit/agent_feedback",
      name: "agent_feedback",
      title: "MoonBit Viewer Agent Feedback Test",
    },
    BrowserBundle::{
      package_path: "tests/browser/moonbit/model_swap",
      name: "model_swap",
      title: "MoonBit Viewer Model Swap Test",
    },
    BrowserBundle::{
      package_path: "tests/browser/moonbit/folding",
      name: "folding",
      title: "MoonBit Viewer Folding Test",
    },
    BrowserBundle::{
      package_path: "tests/browser/moonbit/folding_nested",
      name: "folding_nested",
      title: "MoonBit Viewer Nested Folding Test",
    },
    BrowserBundle::{
      package_path: "tests/browser/moonbit/quick_diff",
      name: "quick_diff",
      title: "MoonBit Viewer Quick Diff Test",
    },
    BrowserBundle::{
      package_path: "tests/browser/moonbit/set_value",
      name: "set_value",
      title: "MoonBit Viewer Set Value Test",
    },
  ]
}

///|
fn perf_bundles() -> Array[BrowserBundle] {
  [
    BrowserBundle::{
      package_path: "tests/browser/moonbit/component",
      name: "component",
      title: "MoonBit Viewer Component Test",
    },
    BrowserBundle::{
      package_path: "tests/browser/moonbit/perf",
      name: "perf",
      title: "MoonBit Viewer Performance Test",
    },
  ]
}

///|
async fn build_js_package(package_path : String) -> Unit {
  let status = @process.run(
    "moon",
    [
      "build",
      "--target",
      "js",
      "--target-dir",
      "_build",
      package_path,
    ],
  )
  if status != 0 {
    fail("moon build failed for \{package_path} with exit code \{status}")
  }
}

///|
async fn write_browser_bundle(
  bundle : BrowserBundle,
  build_dir : String,
  browser_tests_dir : String,
) -> Unit {
  let source_dir = build_dir + "/" + bundle.name
  let generated_js = @fs.read_file(
    source_dir + "/" + bundle.name + ".js",
  ).text()
  @fs.write_file(
    browser_tests_dir + "/" + bundle.name + ".mjs",
    generated_js.replace(
      old="//# sourceMappingURL=" + bundle.name + ".js.map",
      new="//# sourceMappingURL=" + bundle.name + ".mjs.map",
    ),
    create_mode=@fs.CreateOrTruncate,
  )
  @fs.write_file(
    browser_tests_dir + "/" + bundle.name + ".mjs.map",
    @fs.read_file(source_dir + "/" + bundle.name + ".js.map"),
    create_mode=@fs.CreateOrTruncate,
  )
  @fs.write_file(
    browser_tests_dir + "/" + bundle.name + ".html",
    browser_test_html(
      bundle.title,
      "/browser-tests/" + bundle.name + ".mjs",
    ),
    create_mode=@fs.CreateOrTruncate,
  )
}

///|
async fn build_monaco_oracle(browser_tests_dir : String) -> Unit {
  let monaco_entry = "vscode/src/vs/editor/editor.main.ts"
  if !@fs.exists(monaco_entry) {
    fail(
      "browser perf build requires the pinned VS Code checkout at " +
      monaco_entry,
    )
  }
  // Build a browser-runnable oracle directly from the pinned VS Code
  // submodule. It is perf-only and lets the frame suite compare identical
  // traces without relying on a separately versioned monaco-editor package.
  let status = @process.run("./node_modules/.bin/esbuild", [
    monaco_entry,
    "--bundle",
    "--format=esm",
    "--platform=browser",
    "--target=es2022",
    "--outfile=" + browser_tests_dir + "/monaco-oracle.mjs",
    "--loader:.svg=dataurl",
    "--loader:.png=dataurl",
    "--loader:.ttf=dataurl",
    "--external:./codicon.ttf",
    "--log-level=warning",
  ])
  if status != 0 {
    fail(
      "pinned Monaco oracle build failed with exit code " + status.to_string(),
    )
  }
  @fs.write_file(
    browser_tests_dir + "/monaco-oracle.html",
    monaco_oracle_html(),
    create_mode=@fs.CreateOrTruncate,
  )
  @fs.write_file(
    browser_tests_dir + "/codicon.ttf",
    @fs.read_file("viewer/browser/view/codicon/codicon.ttf"),
    create_mode=@fs.CreateOrTruncate,
  )
}

///|
async fn main {
  let args = @env.args()
  let profile = if args.length() > 1 { args[1] } else { "smoke" }
  let bundles = if profile == "smoke" {
    smoke_bundles()
  } else if profile == "perf" {
    perf_bundles()
  } else {
    fail("unknown browser test build profile: \{profile}; expected smoke or perf")
  }
  for bundle in bundles {
    build_js_package(bundle.package_path)
  }

  // The committed moon.work namespaces member artifacts by module name on
  // current moon releases; older layouts keep the bare package path.
  let plain_build_dir = "_build/js/debug/build/tests/browser/moonbit"
  let build_dir = if @fs.exists(plain_build_dir) {
    plain_build_dir
  } else {
    "_build/js/debug/build/moonbitlang/editor/tests/browser/moonbit"
  }
  if !@fs.exists(build_dir) {
    fail("isolated MoonBit browser build did not produce its expected output")
  }
  let browser_tests_dir = "web/dist/browser-tests"
  if !@fs.exists(browser_tests_dir) {
    @fs.mkdir(browser_tests_dir, recursive=true)
  }
  for bundle in bundles {
    write_browser_bundle(bundle, build_dir, browser_tests_dir)
  }
  if profile == "perf" {
    build_monaco_oracle(browser_tests_dir)
  }
  println(
    "Generated \{profile} browser test bundles under web/dist/browser-tests",
  )
}

///|
fn browser_test_html(title : String, script_src : String) -> String {
  (
    $|<!doctype html>
    $|<html lang="en">
    $|  <head>
    $|    <meta charset="UTF-8" />
    $|    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    $|    <title>\{title}</title>
    $|    <link rel="stylesheet" href="/style.css">
    $|  </head>
    $|  <body>
    $|    <div id="app"></div>
    $|    <script type="module" src="\{script_src}"></script>
    $|  </body>
    $|</html>
  )
}

///|
fn monaco_oracle_html() -> String {
  (
    #|<!doctype html>
    #|<html lang="en">
    #|  <head>
    #|    <meta charset="UTF-8" />
    #|    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    #|    <title>Pinned Monaco Scroll Oracle</title>
    #|    <link rel="stylesheet" href="/browser-tests/monaco-oracle.css">
    #|    <style>html,body,#monaco-host{margin:0;width:100%;height:100%;overflow:hidden}</style>
    #|  </head>
    #|  <body><div id="monaco-host"></div></body>
    #|</html>
  )
}
